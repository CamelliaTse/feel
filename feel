def _t() -> dict:
    """根据 LANG 环境变量返回翻译字典。"""
    lang = os.environ.get("LANG", "")
    if lang.startswith("zh"):
        return _ZH
    return _EN


# ── 路径 ──────────────────────────────────────────────────────────────

def _xdg_data_home() -> str:
    """返回 XDG_DATA_HOME，未设置时 fallback 到 ~/.local/share。"""
    base = os.environ.get("XDG_DATA_HOME")
    if base:
        return base
    return os.path.join(os.path.expanduser("~"), ".local", "share")


# ── 文件扩展名约定 ─────────────────────────────────────────────────────
# 默认使用 .feel 扩展名（主日志 log.feel、长文本 *.feel）。
# 设置环境变量 FEEL_MD_EXT=true 时，改用 log.txt 与 *.md 扩展名。
_MD_EXT_ENV = "FEEL_MD_EXT"


def _use_md_ext() -> bool:
    """环境变量 FEEL_MD_EXT 为 true（不区分大小写）时返回 True。"""
    return os.environ.get(_MD_EXT_ENV, "").strip().lower() == "true"


LOG_EXT = ".txt" if _use_md_ext() else ".feel"
LONG_EXT = ".md" if _use_md_ext() else ".feel"

LOG_DIR = os.path.join(_xdg_data_home(), "feel")
LOG_FILE = os.path.join(LOG_DIR, f"log{LOG_EXT}")
LONG_DIR = os.path.join(LOG_DIR, "long")


# ── 核心逻辑 ──────────────────────────────────────────────────────────

def _edit_long() -> None:
    """打开编辑器记录一篇长文本，保存为独立文件。"""
    tr = _t()

    os.makedirs(LONG_DIR, exist_ok=True)
    now = datetime.now()
    base = now.strftime("%Y%m%d-%H%M%S")
    filename = base + LONG_EXT
    filepath = os.path.join(LONG_DIR, filename)
    # 同一秒内重复创建时追加序号，保证每条记录独立文件
    n = 1
    while os.path.exists(filepath):
        n += 1
        filename = f"{base}-{n}{LONG_EXT}"
        filepath = os.path.join(LONG_DIR, filename)
    # 默认 # 标题为 unix 时间戳 + 可读时间，格式与日志行一致
    title = f"{int(now.timestamp())} {now.strftime('%Y-%m-%d %H:%M')}"

    # 写入带标题的模板，供用户在编辑器中续写
    with open(filepath, "w", encoding="utf-8") as f:
        f.write(f"# {title}\n\n")

    editor = os.environ.get("EDITOR", "vim")
    print(tr["long.opening"])

    try:
        ret = subprocess.run(shlex.split(editor) + [filepath])
    except (FileNotFoundError, OSError):
        print(tr["long.editor"].format(editor=editor))
        if os.path.isfile(filepath):
            os.remove(filepath)
        return

    if ret.returncode != 0:
        print(tr["long.editor"].format(editor=editor))
        if os.path.isfile(filepath):
            os.remove(filepath)
        return

    with open(filepath, "r", encoding="utf-8") as f:
        content = f.read()

    # 若文件仍只有模板（用户未写内容），视为取消并清理
    if content.strip() == f"# {title}".strip():
        os.remove(filepath)
        print(tr["long.empty"])
        return

    _write_log(f"long:{os.path.join('long', filename)}")
    print(tr["long.saved"].format(path=filepath))


def _write_log(feeling: str, note: str | None = None) -> None:
    """写入日志行。"""
    now = datetime.now()
    unix_ts = int(now.timestamp())
    timestamp = now.strftime("%Y-%m-%d %H:%M")
    parts = [str(unix_ts), timestamp, feeling]
    if note:
        parts.append(f"({note})")
    log_line = " ".join(parts) + "\n"

    os.makedirs(LOG_DIR, exist_ok=True)

    with open(LOG_FILE, "a", encoding="utf-8") as f:
        f.write(log_line)

    tr = _t()
    print(f"{tr['recorded']}: {log_line.strip()}")


# 同时识别 v2.0.1 默认（unix + 时间）与 v2.0.0 旧默认（纯时间）两种自动标题
_DEFAULT_TITLE_RE = re.compile(r"^(\d+ )?\d{4}-\d{2}-\d{2} \d{2}:\d{2}$")


def _long_title(rel_path: str) -> str:
    """读取长文本文件，返回其第一个 # 标题；未自定义标题时返回 <无摘要>。"""
    tr = _t()
    filepath = os.path.join(LOG_DIR, rel_path)
    try:
        with open(filepath, "r", encoding="utf-8") as f:
            for line in f:
                stripped = line.strip()
                if not stripped:
                    continue
                if stripped.startswith("# "):
                    title = stripped[2:].strip()
                    if _DEFAULT_TITLE_RE.match(title):
                        return tr["list.no_summary"]
                    return title
                break
    except OSError:
        pass
    return tr["list.no_summary"]


def _format_log_line(line: str) -> str:
    """格式化单条日志：长文本条目以本地化前缀 + #标题 替换 raw 路径。"""
    tr = _t()
    line = line.rstrip()
    for part in line.split():
        if part.startswith("long:long/"):
            return line.replace(part, f"{tr['list.long_prefix']} {_long_title(part[len('long:'):])}")
    return line


def _list_logs(count: int | None = 10) -> None:
    """显示最近 count 条日志。count 为 None 时显示所有。"""
    tr = _t()

    if not os.path.isfile(LOG_FILE):
        print(tr["list.empty"])
        return

    with open(LOG_FILE, "r", encoding="utf-8") as f:
        lines = f.readlines()

    if not lines:
        print(tr["list.empty"])
        return

    if count is None:
        recent = lines
    else:
        recent = lines[-count:]

    for i, line in enumerate(recent, start=len(lines) - len(recent) + 1):
        print(f"{i:>4}  {_format_log_line(line)}")


def _find_long_rel(ts_str: str) -> str | None:
    """在日志中按 unix 时间戳或序号（list 显示的行号）查找长文本相对路径。"""
    if not os.path.isfile(LOG_FILE):
        return None
    with open(LOG_FILE, "r", encoding="utf-8") as f:
        lines = f.readlines()

    # 1) 优先按 unix 时间戳精确匹配
    for line in lines:
        parts = line.split()
        if parts and parts[0] == ts_str:
            for part in parts:
                if part.startswith("long:long/"):
                    return part[len("long:"):]
            return None

    # 2) 未匹配到时按序号（list 显示的行号）匹配
    try:
        idx = int(ts_str)
    except ValueError:
        return None
    if 1 <= idx <= len(lines):
        parts = lines[idx - 1].split()
        for part in parts:
            if part.startswith("long:long/"):
                return part[len("long:"):]
    return None


def _read_long(ts_str: str) -> None:
    """按 unix 时间戳或序号读取并打印长文本内容。"""
    tr = _t()
    rel = _find_long_rel(ts_str)
    if rel is None:
        print(tr["read.not_found"].format(ts=ts_str))
        return
    filepath = os.path.join(LOG_DIR, rel)
    if not os.path.isfile(filepath):
        print(tr["read.missing"].format(path=filepath))
        return
    with open(filepath, "r", encoding="utf-8") as f:
        print(f.read(), end="")


def _read_last_long() -> None:
    """读取并打印最后一条长文本记录的内容。"""
    tr = _t()
    if not os.path.isfile(LOG_FILE):
        print(tr["read.last_empty"])
        return
    with open(LOG_FILE, "r", encoding="utf-8") as f:
        lines = f.readlines()
    for line in reversed(lines):
        parts = line.split()
        for part in parts:
            if part.startswith("long:long/"):
                rel = part[len("long:"):]
                filepath = os.path.join(LOG_DIR, rel)
                if not os.path.isfile(filepath):
                    print(tr["read.missing"].format(path=filepath))
                    return
                with open(filepath, "r", encoding="utf-8") as f:
                    print(f.read(), end="")
                return
    print(tr["read.last_empty"])


def _delete_log(ts_str: str) -> None:
    """根据 Unix 时间戳或序号（list 显示的行号）删除对应的日志条目。"""
    tr = _t()

    if not os.path.isfile(LOG_FILE):
        print(tr["list.empty"])
        return

    with open(LOG_FILE, "r", encoding="utf-8") as f:
        lines = f.readlines()

    matched_idx = None
    # 1) 优先按 unix 时间戳精确匹配
    for i, line in enumerate(lines):
        parts = line.strip().split()
        if parts and parts[0] == ts_str:
            matched_idx = i
            break

    # 2) 未匹配到时按序号（list 显示的行号）匹配
    if matched_idx is None:
        try:
            idx = int(ts_str)
        except ValueError:
            idx = None
        if idx is not None and 1 <= idx <= len(lines):
            matched_idx = idx - 1

    if matched_idx is None:
        print(tr["delete.not_found"].format(ts=ts_str))
        return

    print(tr["delete.confirm"])
    print(f"  {lines[matched_idx].rstrip()}")

    try:
        answer = _prompt("[y/N] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return

    if answer in ("y", "yes"):
        del lines[matched_idx]
        with open(LOG_FILE, "w", encoding="utf-8") as f:
            f.writelines(lines)
        print(tr["delete.deleted"])
    else:
        print(tr["delete.cancelled"])


def _delete_last() -> None:
    """删除最后一条日志条目。"""
    tr = _t()

    if not os.path.isfile(LOG_FILE):
        print(tr["delete.last_empty"])
        return

    with open(LOG_FILE, "r", encoding="utf-8") as f:
        lines = f.readlines()

    if not lines:
        print(tr["delete.last_empty"])
        return

    last_idx = len(lines) - 1
    print(tr["delete.confirm"])
    print(f"  {lines[last_idx].rstrip()}")

    try:
        answer = _prompt("[y/N] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return

    if answer in ("y", "yes"):
        del lines[last_idx]
        with open(LOG_FILE, "w", encoding="utf-8") as f:
            f.writelines(lines)
        print(tr["delete.deleted"])
    else:
        print(tr["delete.cancelled"])


def _prompt(prompt: str) -> str:
    """读取用户输入，绕过 readline 以避免 CJK 宽字符丢失问题。"""
    sys.stdout.write(prompt)
    sys.stdout.flush()
    try:
        raw = sys.stdin.buffer.readline()
    except KeyboardInterrupt:
        raise
    return raw.decode("utf-8", errors="replace").rstrip("\n\r")


def _interactive() -> None:
    """交互式 TUI 模式。"""
    tr = _t()
    try:
        feeling = _prompt(tr["interactive.prompt"]).strip()
    except (EOFError, KeyboardInterrupt):
        print()
        sys.exit(0)

    if not feeling:
        sys.exit(0)

    try:
        note = _prompt(tr["interactive.note"]).strip()
    except (EOFError, KeyboardInterrupt):
        print()
        note = ""

    _write_log(feeling, note if note else None)


def _show_help() -> None:
    """显示帮助信息。"""
    tr = _t()
    lang = os.environ.get("LANG", "")
    is_zh = lang.startswith("zh")
    help_cmd_desc = "显示帮助信息" if is_zh else "Show this help message"

    print(tr["help.title"])
    print()
    print(tr["help.commands"])
    print(tr["help.interactive"])
    print(tr["help.record"])
    print(tr["help.long"])
    print(tr["help.read"])
    print(tr["help.list"])
    print(tr["help.delete"])
    print(tr["help.delete_last"])
    print(tr["help.version"])
    print(f"  help, -h, --help     {help_cmd_desc}")
    print()
    print(tr["help.aliases"])
    print(tr["help.alias_list"])
    print(tr["help.alias_list_a"])
    print(tr["help.alias_list_n"])
    print(tr["help.alias_read"])
    print(tr["help.alias_delete"])
    print(tr["help.alias_help"])
    print(tr["help.alias_version"])


def _resolve_aliases(argv: list[str]) -> list[str]:
    """解析别名，将短命令转换为标准命令。"""
    if len(argv) < 2:
        return argv

    cmd = argv[1]

    # help 别名
    if cmd in ("-h", "--help"):
        return [argv[0], "help"]

    # version 别名
    if cmd in ("-v", "--version"):
        return [argv[0], "version"]

    # list 别名
    if cmd == "ls":
        return [argv[0], "list"] + argv[2:]

    # read 别名
    if cmd == "show":
        return [argv[0], "read"] + argv[2:]

    # delete 别名
    if cmd in ("del", "rm"):
        return [argv[0], "delete"] + argv[2:]

    return argv


def main() -> None:
    if len(sys.argv) < 2:
        _interactive()
        return

    argv = _resolve_aliases(sys.argv)

    if argv[1] == "help":
        _show_help()
        return

    if argv[1] == "version":
        print(f"feel v{VERSION}")
        return

    if argv[1] == "long":
        _edit_long()
        return

    if argv[1] == "read":
        if len(argv) < 3:
            tr = _t()
            print(tr["read.usage"])
            sys.exit(1)
        if argv[2] == "last":
            _read_last_long()
        else:
            _read_long(argv[2])
        return

    if argv[1] == "list":
        args = argv[2:]
        count = 10  # 默认值
        show_all = False

        i = 0
        while i < len(args):
            if args[i] in ("-a", "--all"):
                show_all = True
                i += 1
            elif args[i] == "-n":
                if i + 1 >= len(args):
                    tr = _t()
                    print(tr["list.usage"])
                    sys.exit(1)
                try:
                    count = int(args[i + 1])
                    if count <= 0:
                        raise ValueError
                except ValueError:
                    tr = _t()
                    print(tr["list.usage"])
                    sys.exit(1)
                i += 2
            else:
                tr = _t()
                print(tr["list.usage"])
                sys.exit(1)

        _list_logs(count=None if show_all else count)
        return

    if argv[1] == "delete":
        if len(argv) < 3:
            tr = _t()
            print(tr["delete.usage"])
            sys.exit(1)
        if argv[2] == "last":
            _delete_last()
        else:
            _delete_log(argv[2])
        return

    description = " ".join(argv[1:])
    _write_log(description)


if __name__ == "__main__":
    main()
